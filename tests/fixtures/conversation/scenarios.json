          }
        },
        {
          "user": "预览已看过，继续导出。",
          "allow_writes": [
            "export start",
            "export download"
          ],
          "require_calls": [
            "export check",
            "export start",
            "export download"
          ],
          "expect_options": {
            "export start": {
              "--mode": "native",
              "--page-numbers": null,
              "--version-id": "103",
              "--manifest-hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "export download": {
              "--run-id": null
            }
          },
          "target_version": 103,
          "bind_preview": true
        }
      ],
      "review": [
        "第二轮给出结构总览与第一张内容/结论/画面建议/风格效果卡片并停下；第三轮用户明确批量确认后才生成。",
        "第三轮展示实际逐页预览路径；不能把生成成功说成人工审阅通过。",
        "预览后只提供普通 PPT；第四轮直接导出，不再询问模式、转换页数或页码，不承诺文字可编辑。",
        "分析后刷新已提升的版本102；生成工具返回的版本103成为后续预览和导出的目标。"
      ]
    },
